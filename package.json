{
  "name": "gha-security-checks",
  "version": "0.4.0",
  "description": "Reusable security audit engine for GitHub Actions and CI workflows.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gha-security-checks": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "docker",
    "action.yml",
    "Dockerfile",
    "gha-security-checks.example.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node scripts/generate-version.mjs",
    "build": "tsc -p tsconfig.json",
    "precheck": "node scripts/generate-version.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "prepare:action": "ncc build dist/action/main.js -o dist-action --source-map --license licenses.txt"
  },
  "keywords": [
    "github-actions",
    "security",
    "composer",
    "osv",
    "sarif",
    "supply-chain"
  ],
  "author": "lavluda",
  "license": "MIT",
  "homepage": "https://github.com/lavluda/GHA-security-checks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lavluda/GHA-security-checks.git"
  },
  "bugs": {
    "url": "https://github.com/lavluda/GHA-security-checks/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
